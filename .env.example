# Location configuration — what differs between sites.
#
#   cp .env.example .env
#
# Application defaults live in config/cameras.yml. The split is deliberate and worth keeping
# sharp: this file holds host paths and **secrets**, and cameras.yml holds structure. Mixing
# them is how a camera password ends up in a file that gets committed.

# Where the host keeps everything that must survive a container being thrown away:
# the database, the clips, and Frigate's own recordings.
CCTV_DATA_DIR=./data

# The timezone Frigate presents. It should match `site.timezone` in config/cameras.yml —
# clip filenames come from the config, not from here, so a mismatch means the UI and the
# filesystem disagree about what time it is.
TZ=Asia/Kolkata

# ---------------------------------------------------------------------------------------
# Cameras
# ---------------------------------------------------------------------------------------
#
# THESE ARE CREDENTIALS. An RTSP URL carries a username and password, which is why this
# file is gitignored and why the generated Frigate config is too.
#
# The names here (`CAMERA_FRONT_DOOR_...`) are what config/cameras.yml references as
# `${CAMERA_FRONT_DOOR_RTSP}`. An unset variable is a hard error at load time, not a silent
# empty string, so a typo fails at install rather than producing a camera that never
# connects.
#
# The `sub` stream is optional but strongly recommended: detection on the camera's own
# low-resolution sub-stream costs a fraction of running it on the main stream, and almost
# every IP camera provides one.

CAMERA_FRONT_DOOR_RTSP=rtsp://user:password@192.168.1.10:554/Streaming/Channels/101
CAMERA_FRONT_DOOR_SUB=rtsp://user:password@192.168.1.10:554/Streaming/Channels/102

# ---------------------------------------------------------------------------------------
# Images
# ---------------------------------------------------------------------------------------

CCTV_IMAGE=cctv-stack:local

# `stable` is multi-arch. Replace with an architecture-specific tag if you need a particular
# build (for example a TensorRT or arm64-standard variant).
FRIGATE_IMAGE=ghcr.io/blakeblackshear/frigate:stable

# Shared memory Frigate gets. The 64 MB Docker default makes detection stop after a while
# with no error pointing at the cause.
FRIGATE_SHM_SIZE=256mb

# Frigate's authenticated UI, bound to loopback. Port 5000 is never published on purpose —
# Frigate treats requests on it as anonymous admin (integration contract §2).
FRIGATE_UI_PORT=8971

# ---------------------------------------------------------------------------------------
# Worker tuning
# ---------------------------------------------------------------------------------------

# How often the reconciliation sweep runs, in seconds. The sweep is the guarantee that a
# missed MQTT message costs a delay rather than a clip, so this is the worst-case delay
# rather than a performance knob.
CCTV_SWEEP_INTERVAL_S=60

# Set to empty to run sweep-only with no broker subscription at all.
CCTV_MQTT_HOST=mosquitto

# ---------------------------------------------------------------------------------------
# Cloud backup (the uploader service)
# ---------------------------------------------------------------------------------------
#
# Backblaze B2 through its **S3-compatible** endpoint. One bucket per site, named
# after the location in `cameras.yml` — `cctv-<location>` by convention.
#
# Leave `CCTV_STORAGE_BUCKET` EMPTY for a local-only install. The uploader still runs, but it
# reports DISABLED and uploads nothing, which is an honest state rather than a silent one. A
# half-configured bucket (a bucket with no key) is refused at start-up instead, because that
# is a mistake rather than a choice.
#
# THESE ARE CREDENTIALS. Create an application key scoped to this bucket alone, with
# read/write access. Do not use the master key: a leaked site key must not be able to read
# another site's footage.

CCTV_STORAGE_BUCKET=
CCTV_STORAGE_KEY_ID=
CCTV_STORAGE_APPLICATION_KEY=

# Must match the region in the bucket's S3 endpoint.
CCTV_STORAGE_REGION=us-west-004

# Derived from the region when unset, so it is only needed for a non-standard endpoint.
# CCTV_STORAGE_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com

# How fast to retry a failed upload. The defaults are ~15 s doubling to a 1 h ceiling, with
# 12 attempts before a clip is kept locally and alerted on instead of retried forever.
# CCTV_UPLOAD_MAX_ATTEMPTS=12
# CCTV_UPLOAD_BACKOFF_BASE_S=15
# CCTV_UPLOAD_BACKOFF_MAX_S=3600
# CCTV_UPLOAD_CONCURRENCY=4

# ---------------------------------------------------------------------------------------
# Service surfaces
# ---------------------------------------------------------------------------------------

# The uploader's health and admin endpoints, bound to loopback only.
UPLOADER_HEALTH_PORT=8082

# Cleanup's health endpoint (`/health`, `/metrics`), bound to loopback only.
CLEANUP_HEALTH_PORT=8083

# How often local retention runs, and how many clips are handled per transaction. A clip is
# deleted only when its upload is terminal-success, so a backlog is held, never deleted.
# CCTV_CLEANUP_RUN_INTERVAL_S=3600
# CCTV_CLEANUP_BATCH_SIZE=200

# Extra local retention for a camera that was removed from `cameras.yml`. Clips from a retired
# camera otherwise expire on the default 90-day window.
# CCTV_CLEANUP_RETIRE_GRACE_DAYS=0

# Held-clip thresholds. 0 is healthy; 1 or more is DEGRADED; above the critical count, or held
# for longer than the age limit, is UNHEALTHY. This is how "we are holding your data rather
# than deleting it" becomes visible before the disk fills.
# CCTV_CLEANUP_OVERDUE_WARN=1
# CCTV_CLEANUP_OVERDUE_CRITICAL=10
# CCTV_CLEANUP_OVERDUE_AGE_CRITICAL_DAYS=30

# Free-space thresholds, shared by every service's health surface.
# CCTV_HEALTH_DISK_WARN_PCT=15
# CCTV_HEALTH_DISK_CRITICAL_PCT=5

# Shared secret for the uploader's admin endpoints (`/admin/queue`, `/admin/retry`). Generated
# during install; without it those endpoints are not mounted at all. Never published to the
# LAN, and never logged.
INTERNAL_API_TOKEN=

# Set to 1 to log what the uploader *would* do without uploading anything.
# DRY_RUN=0

CCTV_LOG_LEVEL=INFO
